{
  "name": "hafez-almatama",
  "version": "1.0.0",
  "description": "نظام إدارة حافز المتمة - نسخة سطح مكتب",
  "main": "main.js",
  "author": "Hafez Almatama",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win32": "electron-builder --win nsis --ia32",
    "build:win64": "electron-builder --win nsis --x64",
    "build:all": "npm run build:win32 && npm run build:win64"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "sd.hafez.almatama",
    "productName": "حافز المتمة",
    "directories": { "output": "dist" },
    "files": ["index.html", "main.js", "package.json"],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [{ "target": "nsis", "arch": ["ia32", "x64"] }],
      "artifactName": "Hafez-Almatama-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "حافز المتمة",
      "deleteAppDataOnUninstall": false
    }
  }
}
